# CTS experiments. Copy to .env and load before any command:  set -a; source .env; set +a
# Shell syntax; .env is ignored by Git. Do not put credentials here.

# Work root OUTSIDE the source checkout: weights, data, runs and evaluations live here.
SPIKE_WORK_ROOT=/path/to/work

# Asset paths (defaults under SPIKE_WORK_ROOT, see experiments/libero/settings.py). Uncomment to override.
# SPIKE_DATA_ROOT=/path/to/work/datasets/libero
# SPIKE_BERT_PATH=/path/to/work/pretrained/TurboVLA/backbones/bert-base-uncased
# SPIKE_DINO_PATH=/path/to/work/pretrained/TurboVLA/backbones/dinov3-vitb16
# SPIKE_TEXT_PATH=/path/to/work/pretrained/SmoothSpike/smoothspike-bert-base-fused
# SPIKE_VISION_CHECKPOINT=/path/to/work/pretrained/SDT-V3/V3_19.0M_1x4.pth
# SPIKE_GROUNDING_CHECKPOINT=/path/to/work/pretrained/GroundingDINO/groundingdino_swint_ogc.pth
# SPIKE_TEACHER_CHECKPOINT=/path/to/work/pretrained/TurboVLA/checkpoints/libero/turbovla_libero.pth
# SPIKE_LIBERO_ROOT=/path/to/work/benchmarks/LIBERO
# LIBERO_CONFIG_PATH=/path/to/work/benchmarks/LIBERO/.libero
# Leave SPIKE_CUDA_DEVICES unset: it belongs to the old 3-GPU pipeline and must name exactly 3 GPUs.

# CTS layout used in docs/cts/EXPERIMENTS.md.
CTS_ROOT=${SPIKE_WORK_ROOT}/cts
CTS_RUNS=${CTS_ROOT}/runs
CTS_EVAL=${CTS_ROOT}/eval
# Calibrated SmoothSpike text projection (step 0 of EXPERIMENTS.md writes it).
CTS_TEXT_PROJECTION=${CTS_ROOT}/text_init/text_projection.pth
CTS_VISION=${SPIKE_WORK_ROOT}/pretrained/SDT-V3/V3_19.0M_1x4.pth
# Trained spike-driven-vla checkpoint (E0-base or the published run): E0 diagnostics and the P0 pilot.
# CTS_BASE_CHECKPOINT=/path/to/spike_driven_vla_40000.pth

# Keep user site-packages out of the conda env.
PYTHONNOUSERSITE=1

# Tests: tests/cts finds bert-base-uncased in the HF cache or here; the training smoke test needs LeRobot data.
# CTS_TEST_BERT=/path/to/work/pretrained/TurboVLA/backbones/bert-base-uncased
# CTS_TEST_LIBERO_DATA=/path/to/work/datasets/libero
